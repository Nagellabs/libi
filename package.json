{
  "name": "@nagellabs/libi",
  "version": "0.1.8",
  "publishConfig": {
    "access": "public"
  },
  "description": "AI video studio — a desktop editor that connects CLI coding agents (Claude Code, Codex) over ACP and lets them compose, edit and export video.",
  "keywords": [
    "video",
    "video-editor",
    "ai",
    "agent",
    "acp",
    "mcp",
    "claude-code",
    "codex",
    "ffmpeg",
    "electron"
  ],
  "homepage": "https://github.com/Nagellabs/libi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nagellabs/libi.git"
  },
  "bugs": {
    "url": "https://github.com/Nagellabs/libi/issues",
    "email": "support@nagellabs.com"
  },
  "author": "Nadav Nagel <support@nagellabs.com>",
  "license": "GPL-3.0-only",
  "libi": {
    "shellApiVersion": 1
  },
  "main": "dist-electron/electron/main.js",
  "bin": {
    "libi": "bin/libi.js"
  },
  "files": [
    "THIRD-PARTY-NOTICES.md",
    "bin/**/*",
    "lib/**/*",
    "mcp/**/*",
    "dist-cli/**/*",
    "!mcp/dev/**",
    "!mcp/**/__pycache__/**",
    "!mcp/tracking/py/.venv/**",
    "!mcp/tracking/py/**/.pytest_cache/**",
    "app/**/*",
    "components/**/*",
    "hooks/**/*",
    "public/**/*",
    "drizzle/**/*",
    "next.config.ts",
    "next-logger.config.js",
    "tsconfig.json",
    ".next/**/*",
    "!.next/**/*.map",
    "!.next/standalone",
    "!.next/dev",
    "!.next/cache",
    "!.next/trace",
    "!.next/types"
  ],
  "scripts": {
    "prepack": "node scripts/clean-npm-pack-artifacts.js && node scripts/build-cli.js",
    "build:cli": "node scripts/build-cli.js",
    "verify:cli": "node scripts/build-cli.js --verify",
    "predev": "node scripts/ensure-native-modules.js",
    "dev": "node bin/libi.js",
    "build": "next build && node scripts/write-next-externals-manifest.js",
    "prebuild:electron": "node scripts/generate-third-party-notices.js --check && node scripts/ensure-electron-binary.js",
    "build:electron": "node scripts/rebuild-for-electron.js && npm run compile:electron && node scripts/next-build-release.js && node scripts/build-runtime-bundle.js && electron-builder",
    "build:runtime-bundle": "node scripts/build-runtime-bundle.js",
    "verify:runtime-bundle": "node scripts/build-runtime-bundle.js --verify",
    "compile:electron": "node scripts/build-electron.js",
    "electron": "electron dist-electron/electron/main.js",
    "predev:electron": "node scripts/ensure-native-modules.js && node scripts/ensure-electron-binary.js",
    "dev:electron": "node scripts/dev-electron.js",
    "start": "next start",
    "lint": "eslint",
    "check:licenses": "bash scripts/check-licenses.sh",
    "notices:generate": "node scripts/generate-third-party-notices.js",
    "notices:check": "node scripts/generate-third-party-notices.js --check",
    "pretest": "node scripts/ensure-native-modules.js",
    "test": "vitest run",
    "pretest:watch": "node scripts/ensure-native-modules.js",
    "test:watch": "vitest",
    "pretest:coverage": "node scripts/ensure-native-modules.js",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:electron": "npm run compile:electron && playwright test --config=playwright.electron.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prepare": "electron-builder install-app-deps",
    "track:eval": "tsx scripts/track-eval/index.ts",
    "matte:eval": "tsx scripts/matte-eval/index.ts",
    "fal:billing:probe": "tsx scripts/fal-billing/probe.ts",
    "onboarding:extract": "tsx scripts/extract-onboarding-piece.ts",
    "skill:eval": "tsx scripts/skill-eval/run.ts",
    "skill:eval:index": "tsx scripts/skill-eval/build-index.ts",
    "skill:eval:audit": "tsx scripts/skill-eval/audit-endpoints.ts",
    "preview:eval": "node scripts/preview-warming-eval.mjs",
    "registry:start": "node scripts/local-registry/start.js",
    "registry:stop": "node scripts/local-registry/stop.js",
    "registry:publish": "node scripts/local-registry/publish.js",
    "registry:install": "node scripts/local-registry/install.js",
    "registry:e2e": "node scripts/local-registry/e2e.js",
    "registry:upgrade": "node scripts/local-registry/upgrade.js",
    "release:npm": "node scripts/release-npm.js",
    "release:electron": "node scripts/release-electron.js"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "^1.6.2",
    "@agentclientprotocol/sdk": "^1.4.0",
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fal-ai/client": "^1.10.1",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@napi-rs/canvas": "^0.1.100",
    "@opentelemetry/instrumentation": "^0.214.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/nextjs": "^10.57.0",
    "@sentry/node": "^10.57.0",
    "@tanstack/react-query": "^5.97.0",
    "@tanstack/react-table": "^8.21.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.0",
    "better-sqlite3": "^12.8.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.0",
    "gray-matter": "^4.0.3",
    "import-in-the-middle": "^3.0.2",
    "konva": "^10.3.0",
    "lucide-react": "^1.8.0",
    "mediabunny": "^1.40.1",
    "next": "16.2.3",
    "next-logger": "^5.0.2",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "npm": "^11.15.0",
    "opentype.js": "^2.0.0",
    "ora": "8.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright-core": "^1.59.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-konva": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "require-in-the-middle": "^8.0.1",
    "roughjs": "^4.6.6",
    "satori": "^0.26.0",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.29.0",
    "vaul": "^1.1.2",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.70.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.4",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.10",
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4",
    "tsc-alias": "^1.8.17",
    "typescript": "^5",
    "vitest": "^4.1.4",
    "wait-on": "^8.0.3"
  }
}

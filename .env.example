# Optional: API keys for SDK agent providers
# (Not needed if using CLI agents like Claude Code or Codex)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ElevenLabs API key (for audio generation tools)
ELEVENLABS_API_KEY=sk_...

# fal.ai API key (for video/image generation and tracking tools). This is a
# PAID, real-money external service — generations are billed to this key.
# Usually configured per-server in Settings → MCP Servers → fal-ai instead;
# set here only as a dev convenience. FAL_AI_KEY is also read (checked first,
# for .env.local dev ergonomics); FAL_KEY is the canonical/legacy name.
# FAL_KEY=...

# Override the Libi data directory (default: ~/.libi)
# LIBI_HOME=~/.libi

# Override the host libi's Next.js server binds to (default: 127.0.0.1,
# loopback-only). Changing this exposes the studio — and every libi.* tool
# call an agent can make — to other devices on the network. Only set this if
# you deliberately intend remote access and understand the exposure.
# LIBI_HOST=127.0.0.1

# Override individual paths (rarely needed):
# DB_PATH=~/.libi/libi.sqlite
# STORAGE_DIR=~/.libi/storage

# Preview-engine telemetry (always-on instrumentation for the editor's playback
# pipeline: decode ring, audio clock, compositor, React loop). When "1", the
# editor records to window.__libiPreviewTelemetry from load — call .summary() in
# the console. Also toggleable at runtime via .enable()/.disable() or
# localStorage["libi:preview-telemetry"]. Leave unset in normal use (zero cost).
# NEXT_PUBLIC_LIBI_PREVIEW_TELEMETRY=1

# ── Sentry (error + log monitoring) ─────────────────────────────────────────
# Pseudonymous reliability telemetry — see README "Error & Log Monitoring (Sentry)".
# The DSN is COMMITTED as a default in lib/sentry/config.ts (a DSN is not a
# secret — it only grants SENDING events), so end-user installs work with NO
# config here. Everything below is OPTIONAL.
#
# Enablement is gated: ON for real installs (npx @nagellabs/libi / packaged Electron),
# OFF in a dev clone. To test tracking from a clone, force it on:
# NEXT_PUBLIC_LIBI_SENTRY=1
# Hard kill-switch (wins over everything, e.g. local production builds):
# LIBI_SENTRY_DISABLED=1
#
# Override the committed DSN (e.g. a staging project or self-hosted Sentry).
# ONE var is enough — NEXT_PUBLIC_* is readable on the server too, and a DSN is
# public (send-only). No separate server-side SENTRY_DSN needed.
# NEXT_PUBLIC_SENTRY_DSN=https://<publicKey>@o<org>.ingest.sentry.io/<project>
# NEXT_PUBLIC_LIBI_SENTRY_ENV=staging   # environment tag (default: production)
#
# Source-map upload — OPTIONAL, build-time only. The `npx @nagellabs/libi` CLI runs a
# production Next build in-process (`next({ dev: false })`, lib/cli/studio.ts) — same
# as the packaged Electron build — so BOTH ship minified traces and both benefit from
# this. Nothing here affects error CAPTURE; it only de-minifies stack traces in the
# Sentry dashboard. Org/project are committed defaults (nagellabs / libi-editor in
# next.config.ts), so a release build only needs the secret token below. With no
# token, upload is skipped (build still succeeds).
# SENTRY_AUTH_TOKEN=sntrys_...      # SECRET — put in .env.sentry-build-plugin
#                                   # (gitignored) or CI secrets, never commit
# Override the committed org/project only for a fork or staging project:
# SENTRY_ORG=your-org-slug          # default: nagellabs
# SENTRY_PROJECT=your-project-slug  # default: libi-editor

# ── Product analytics (GA4) ─────────────────────────────────────────────────
# Committed measurement ID (public) in lib/analytics/config.ts, Sentry-style.
# OFF by default; launchers set NEXT_PUBLIC_LIBI_ANALYTICS=1 for real installs.
# Both the browser and the server transport post to the GA4 web-stream
# endpoint (no secret needed — see lib/analytics/collect-url.ts). All
# variables below are OPTIONAL.
# NEXT_PUBLIC_LIBI_ANALYTICS=1                  # force-enable from a dev clone
# LIBI_ANALYTICS_DISABLED=1                     # hard kill-switch (wins)
# LIBI_ANALYTICS_DEBUG=1                        # send debug_mode so hits land in GA4
#                                               # DebugView instead of the reports — the
#                                               # only way to inspect a RELEASED build's
#                                               # event parameters. QA only.
# NEXT_PUBLIC_LIBI_GA4_MEASUREMENT_ID=G-XXXX    # override measurement id
